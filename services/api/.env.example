# Copy to .env (never commit .env). All settings are read from NOVARA_* variables.
NOVARA_ENV=development
# Runtime role: NOT the schema owner, so PostgreSQL row-level security applies.
NOVARA_DATABASE_URL=postgresql+psycopg://novara_app:change-me-app@localhost:5432/novara
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NOVARA_JWT_SECRET=
NOVARA_SESSION_TTL_MINUTES=720
NOVARA_STORAGE_ROOT=./storage
NOVARA_MAX_UPLOAD_BYTES=26214400
NOVARA_CORS_ORIGINS=http://localhost:3000
